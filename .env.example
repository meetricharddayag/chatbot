# Dify service API base URL, including /v1.
DIFY_API_BASE_URL=http://localhost/v1

# Dify Console API URL and a valid Console access token.
# For a local Dify install, the Console API is often http://localhost/console/api.
DIFY_CONSOLE_API_BASE_URL=http://localhost/console/api
DIFY_CONSOLE_API_TOKEN=
# The Console API also requires a CSRF token. Copy the `csrf_token` cookie
# value from a logged-in Dify web console session.
DIFY_CONSOLE_CSRF_TOKEN=
# Dify web console URL, used to redirect visitors who are not signed in.
DIFY_CONSOLE_WEB_URL=http://localhost
# Comma-separated options shown in the thumbs-down feedback modal.
FEEDBACK_OPTIONS=Poor answer,Wrong answer,Did not answer,Irrelevant answer
